# Optional: require Bearer token on POST /capture
LIVE_TOKEN=

# Required to overwrite an existing Monday week freeze
WEEK_REISSUE_PASSWORD=change-me

# Railway sets this; local default 8000
PORT=8000

# Optional: email when live MAE is ≥1.5× holdout or coverage < 55%
# Gmail: smtp.gmail.com, port 587, app password
DRIFT_EMAIL_TO=
DRIFT_EMAIL_FROM=
DRIFT_SMTP_HOST=
DRIFT_SMTP_PORT=587
DRIFT_SMTP_USER=
DRIFT_SMTP_PASSWORD=
